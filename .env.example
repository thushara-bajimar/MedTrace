# MedTrace configuration. Copy to .env and change values. Never commit .env.
# Secret used to sign nothing sensitive client-side; sessions are server-side random tokens.
MEDTRACE_DATA_DIR=./runtime-data
# Bootstrap administrator created on first start if no users exist.
MEDTRACE_ADMIN_USERNAME=admin
# REQUIRED: set a strong password. If unset, a random one is generated and printed once at startup.
MEDTRACE_ADMIN_PASSWORD=
MEDTRACE_MAX_UPLOAD_MB=15
MEDTRACE_SESSION_HOURS=8
# Set to 1 only when serving over HTTPS so cookies get the Secure flag.
MEDTRACE_COOKIE_SECURE=0
# Comma-separated list of allowed browser origins for the dev frontend.
MEDTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# OCR engine: rapidocr (local ONNX) or none
MEDTRACE_OCR_ENGINE=rapidocr
